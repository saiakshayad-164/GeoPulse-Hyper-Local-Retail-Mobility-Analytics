
-- GeoPulse Week 2
-- Member 1: GPS Data Generation & Snowflake

-- 1. GPS and Store record counts
SELECT 'GPS_PINGS' AS TABLE_NAME, COUNT(*) AS TOTAL_RECORDS
FROM GEOPULSE_DB.PUBLIC.GPS_PINGS
UNION ALL
SELECT 'STORE_MASTER', COUNT(*)
FROM GEOPULSE_DB.PUBLIC.STORE_MASTER;

-- 2. GPS GEOGRAPHY validation
SELECT
    DEVICEID,
    LATITUDE,
    LONGITUDE,
    EVENT_TIMESTAMP,
    ST_ASWKT(LOCATION) AS GEO_LOCATION
FROM GEOPULSE_DB.PUBLIC.GPS_PINGS
LIMIT 10;

-- 3. Store GEOGRAPHY validation
SELECT
    STORE_ID,
    STORE_NAME,
    AREA,
    STORE_TYPE,
    ST_ASWKT(LOCATION) AS GEO_LOCATION
FROM GEOPULSE_DB.PUBLIC.STORE_MASTER;
